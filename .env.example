# Optional enquiry persistence. When unset, the form can still send email.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ragmarbles

# Optional Gmail delivery. Use a Gmail app password, not your normal password.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Public canonical site URL, used by sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:4028
